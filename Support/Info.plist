<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with what Xcode generates from the INFOPLIST_KEY_* build settings. -->
<plist version="1.0">
<dict>
	<!-- Long-press on the icon (QuickLook in FUMailKit, as Android's shortcuts). -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>rest-of-today</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Rest of Today</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>calendar</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>pending-drafts</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Pending Drafts</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>envelope.badge</string>
		</dict>
	</array>
	<!-- Other names Siri takes for the app (at most 3 per language: App Store Connect refuses more) ("What's left today in MC Agent"); the app keeps its name. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>MC Agent</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>em see agent</string>
		</dict>
	</array>
	<!-- Plain HTTP only to local addresses: IP addresses (Tailscale 100.x), .local names and
	     names without dots (MagicDNS). Anything else needs HTTPS (tailscale serve). The app also sends
	     requests only to the host in Settings, with redirects refused. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Open in Obsidian. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>obsidian</string>
	</array>
	<!-- Only Apple's own HTTPS (exempt from export paperwork), so TestFlight doesn't ask per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
